# Supabase Postgres
DATABASE_URL=
DIRECT_URL=

# Session
SESSION_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:4000/api/auth/kakao/callback

# OAuth 로그인 성공 후 이동할 주소 (선택)
# Google/Kakao 콜백 처리가 끝나면 이 주소(프론트엔드)로 리디렉션한다. 프론트가 시작할 때
# GET /api/auth/me로 세션을 확인해 로그인 상태를 반영한다.
# 비워 두면 /api/auth/me로 이동해 로그인된 사용자 정보를 JSON으로 보여준다 (백엔드만 확인할 때).
OAUTH_SUCCESS_REDIRECT=http://localhost:5173

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
