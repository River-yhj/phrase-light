generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  // 로컬 회원가입은 email이 필수지만, 카카오 로그인은 이메일 동의항목이
  // 비즈 앱 전환 승인 전까지 제공되지 않을 수 있어 선택값으로 둔다.
  // (unique는 유지해도 안전 — Postgres는 NULL끼리는 중복으로 취급하지 않음)
  email        String?  @unique
  passwordHash String?
  provider     String? // "local" | "google" | "kakao"
  providerId   String?
  name         String?
  createdAt    DateTime @default(now())

  wordEntries WordEntry[]
  stories     Story[]
  comments    Comment[]
  votes       Vote[]

  // 같은 소셜 계정으로 중복 가입되는 것을 막는 실질적인 식별자
  @@unique([provider, providerId])
}

model WordEntry {
  id          String   @id @default(cuid())
  // 같은 단어가 여러 WordEntry로 쪼개지지 않도록 unique 제약을 건다.
  // 등록 API는 반드시 find-or-create(이미 있으면 재사용)로 구현한다.
  word        String   @unique
  // 외부 사전(Wiktionary)에서 등록 시 한 번 채우고 고정하는 뜻 목록 (수정 API 없음)
  // 형식: [{ "partOfSpeech": "noun", "text": "..." }, ...] — 사전 순서 유지, 품사별 최대 3개
  // NULL = 아직 못 가져옴 (상세 조회 때 재시도 대상)
  definitions Json?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  stories Story[]

  @@index([userId])
}

model Story {
  id          String    @id @default(cuid())
  content     String
  imageUrl    String?
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  wordEntryId String
  wordEntry   WordEntry @relation(fields: [wordEntryId], references: [id])
  createdAt   DateTime  @default(now())

  // Vote 개수를 매번 집계하지 않고 미리 계산해두는 카운터.
  // 투표/취소 시 트랜잭션으로 Vote 생성·삭제와 함께 +1/-1 갱신한다.
  voteCount Int @default(0)

  comments Comment[]
  votes    Vote[]

  @@index([userId])
  @@index([wordEntryId])
  @@index([wordEntryId, voteCount])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  storyId   String
  // Story를 지우면 달린 댓글도 함께 지운다
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  parentId  String?
  // 부모 댓글을 지우면 대댓글 스레드 전체를 함께 지운다 (SetNull이면 대댓글이 최상위로 떠버림)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())

  @@index([storyId])
  @@index([parentId])
}

// User <-> Story 업보트: N:M 관계를 나타내는 조인 테이블
model Vote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  storyId   String
  // Story를 지우면 투표 기록도 함께 지운다
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, storyId])
}
