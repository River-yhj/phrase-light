generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  // 로컬 회원가입은 email이 필수지만, 카카오 로그인은 이메일 동의항목이
  // 비즈 앱 전환 승인 전까지 제공되지 않을 수 있어 선택값으로 둔다.
  // (unique는 유지해도 안전 — Postgres는 NULL끼리는 중복으로 취급하지 않음)
  email        String?  @unique
  passwordHash String?
  provider     String? // "local" | "google" | "kakao"
  providerId   String?
  name         String?
  createdAt    DateTime @default(now())

  wordEntries WordEntry[]
  notes       Note[]

  // 같은 소셜 계정으로 중복 가입되는 것을 막는 실질적인 식별자
  @@unique([provider, providerId])
}

model WordEntry {
  id          String   @id @default(cuid())
  // 같은 단어가 여러 WordEntry로 쪼개지지 않도록 unique 제약을 건다.
  // 등록 API는 반드시 find-or-create(이미 있으면 재사용)로 구현한다.
  word        String   @unique
  // 외부 사전(Wiktionary)에서 등록 시 한 번 채우고 고정하는 뜻 목록 (수정 API 없음)
  // 형식: [{ "partOfSpeech": "noun", "text": "..." }, ...] — 사전 순서 유지, 품사별 최대 3개
  // NULL = 아직 못 가져옴 (상세 조회 때 재시도 대상)
  definitions Json?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  noteMatches NoteMatch[]

  @@index([userId])
}

// 분석 노트 — 사용자가 분석한 영어 글을 출처 사진과 함께 저장한다. 작성자만 볼 수 있다.
model Note {
  id             String   @id @default(cuid())
  title          String
  // 분석한 원문 (최대 5,000자). 저장·수정할 때마다 문장 분석기로 NoteMatch를 다시 만든다.
  text           String
  // 출처 사진 (교재 페이지, 기사 캡처 등) — "/uploads/<파일명>" 상대경로, 선택
  sourceImageUrl String?
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matches NoteMatch[]

  @@index([userId, updatedAt])
}

// 노트에서 찾은 표현 — 분석 노트 N:M 단어를 잇는 테이블.
// 어떤 단어가 원문의 어디에(start/end, JS 문자열 인덱스) 어떤 형태(matchedText)로 나왔는지 기록한다.
model NoteMatch {
  id          String    @id @default(cuid())
  noteId      String
  // 노트를 지우거나 원문을 고치면 찾은 표현도 함께 지운다
  note        Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  wordEntryId String
  wordEntry   WordEntry @relation(fields: [wordEntryId], references: [id])
  matchedText String
  start       Int
  end         Int

  @@index([noteId])
  @@index([wordEntryId])
}
