generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  // 로컬 회원가입은 email이 필수지만, 카카오 로그인은 이메일 동의항목이
  // 비즈 앱 전환 승인 전까지 제공되지 않을 수 있어 선택값으로 둔다.
  // (unique는 유지해도 안전 — Postgres는 NULL끼리는 중복으로 취급하지 않음)
  email        String?  @unique
  passwordHash String?
  provider     String?  // "local" | "google" | "kakao"
  providerId   String?
  name         String?
  createdAt    DateTime @default(now())

  wordEntries  WordEntry[]
  stories      Story[]
  comments     Comment[]
  votes        Vote[]

  // 같은 소셜 계정으로 중복 가입되는 것을 막는 실질적인 식별자
  @@unique([provider, providerId])
}

model WordEntry {
  id        String   @id @default(cuid())
  word      String
  meaning   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  stories   Story[]

  @@index([userId])
}

model Story {
  id          String   @id @default(cuid())
  content     String
  imageUrl    String?
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  wordEntryId String
  wordEntry   WordEntry @relation(fields: [wordEntryId], references: [id])
  createdAt   DateTime  @default(now())

  comments    Comment[]
  votes       Vote[]

  @@index([userId])
  @@index([wordEntryId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  storyId   String
  story     Story     @relation(fields: [storyId], references: [id])
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())

  @@index([storyId])
  @@index([parentId])
}

// User <-> Story 업보트: N:M 관계를 나타내는 조인 테이블
model Vote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, storyId])
}
